diff -ruN '--exclude=textures' '--exclude=sounds' '--exclude=build' '--exclude=.gradle' nightfall_reboot/src/main/java/dev/eternalskies/nightfall/registry/NightfallSounds.java nightfall_reboot_artpass/src/main/java/dev/eternalskies/nightfall/registry/NightfallSounds.java
--- nightfall_reboot/src/main/java/dev/eternalskies/nightfall/registry/NightfallSounds.java	1970-01-01 00:00:00.000000000 +0000
+++ nightfall_reboot_artpass/src/main/java/dev/eternalskies/nightfall/registry/NightfallSounds.java	2026-08-17 22:50:21.091218856 +0000
@@ -0,0 +1,34 @@
+package dev.eternalskies.nightfall.registry;
+
+import dev.eternalskies.nightfall.EternalSkiesNightfall;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.sounds.SoundEvent;
+import net.minecraftforge.registries.DeferredRegister;
+import net.minecraftforge.registries.ForgeRegistries;
+import net.minecraftforge.registries.RegistryObject;
+
+public final class NightfallSounds {
+    public static final DeferredRegister<SoundEvent> SOUND_EVENTS =
+        DeferredRegister.create(ForgeRegistries.SOUND_EVENTS, EternalSkiesNightfall.MOD_ID);
+
+    public static final RegistryObject<SoundEvent> DUSKBORN_AMBIENT = register("duskborn_ambient");
+    public static final RegistryObject<SoundEvent> DUSKBORN_HURT = register("duskborn_hurt");
+    public static final RegistryObject<SoundEvent> DUSKBORN_DEATH = register("duskborn_death");
+    public static final RegistryObject<SoundEvent> DUSKBORN_VEIL = register("duskborn_veil");
+    public static final RegistryObject<SoundEvent> DUSKBORN_BOLT = register("duskborn_bolt");
+    public static final RegistryObject<SoundEvent> DUSKBORN_FLAP = register("duskborn_flap");
+
+    public static final RegistryObject<SoundEvent> STORMLING_AMBIENT = register("stormling_ambient");
+    public static final RegistryObject<SoundEvent> STORMLING_HURT = register("stormling_hurt");
+    public static final RegistryObject<SoundEvent> STORMLING_DEATH = register("stormling_death");
+    public static final RegistryObject<SoundEvent> STORMLING_CHARGE = register("stormling_charge");
+    public static final RegistryObject<SoundEvent> STORMLING_PULSE = register("stormling_pulse");
+    public static final RegistryObject<SoundEvent> STORMLING_DISCHARGE = register("stormling_discharge");
+
+    private NightfallSounds() {}
+
+    private static RegistryObject<SoundEvent> register(String name) {
+        ResourceLocation id = new ResourceLocation(EternalSkiesNightfall.MOD_ID, name);
+        return SOUND_EVENTS.register(name, () -> SoundEvent.createVariableRangeEvent(id));
+    }
+}
