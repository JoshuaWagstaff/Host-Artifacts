"""
ASSET_1_B64 = """"""
ASSET_2_B64 = """"""
ASSET_3_B64 = """"""

patch_bytes = gzip.decompress(base64.b64decode(PATCH_GZ_B64))
print("refinement patch sha256", hashlib.sha256(patch_bytes).hexdigest())
subprocess.run(["patch", "--batch", "-p1", "-d", str(ROOT)], input=patch_bytes, check=True)

assets = [
    ("src/main/resources/assets/eternal_skies_nightfall/textures/entity/duskborn.png", ASSET_0_B64),
    ("src/main/resources/assets/eternal_skies_nightfall/textures/entity/duskborn_glow.png", ASSET_1_B64),
    ("src/main/resources/assets/eternal_skies_nightfall/textures/entity/stormling.png", ASSET_2_B64),
    ("src/main/resources/assets/eternal_skies_nightfall/textures/entity/stormling_glow.png", ASSET_3_B64),
]
for rel, data in assets:
    out = ROOT / rel
    out.parent.mkdir(parents=True, exist_ok=True)
    raw = base64.b64decode(data)
    out.write_bytes(raw)
    print(rel, len(raw), hashlib.sha256(raw).hexdigest())

props=(ROOT/"gradle.properties").read_text()
assert "mod_version=0.1.0-reboot-c" in props
model=(ROOT/"src/main/java/dev/eternalskies/nightfall/client/model/DuskbornModel.java").read_text()
assert "HierarchicalModel<DuskbornEntity>" in model
entities=(ROOT/"src/main/java/dev/eternalskies/nightfall/registry/NightfallEntities.java").read_text()
assert "AETHER_DARKNESS_MONSTER" in entities and "AETHER_SKY_MONSTER" in entities
print("Nightfall refinement C applied")
